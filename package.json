{
  "name": "maicle-co-monorepo",
  "private": true,
  "packageManager": "pnpm@10.6.5",
  "pnpm": {
    "overrides": {
      "@typescript-eslint/eslint-plugin": "^8.0.0",
      "@typescript-eslint/parser": "^8.0.0"
    },
    "onlyBuiltDependencies": [
      "supabase"
    ],
    "ignoredBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  },
  "engines": {
    "node": ">=20.17.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:web:turbo": "pnpm --filter web dev:turbo",
    "build:web": "pnpm --filter web build",
    "start:web": "pnpm --filter web start",
    "storybook:web": "pnpm --filter web storybook",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "rm -rf apps/web/.next",
    "kill:3000": "pnpm dlx kill-port 3000",
    "e2e:install-browsers": "playwright install --with-deps chromium",
    "e2e:smoke": "playwright test --config=playwright.config.ts",
    "e2e:smoke:debug": "PWDEBUG=1 playwright test --config=playwright.config.ts",
    "e2e:smoke:ci": "playwright test --config=playwright.config.ts --reporter=html",
    "db:start": "pnpm exec supabase start",
    "db:stop": "pnpm exec supabase stop",
    "db:reset": "pnpm exec supabase db reset --local",
    "db:diff": "sh -c 'mkdir -p supabase/migrations && pnpm exec supabase db diff --use-migra --output supabase/migrations/$(date -u +%Y%m%d%H%M%S)_schema.sql'",
    "db:link:staging": "dotenv -e apps/web/.env.local -- sh -c 'test -n \"$SUPABASE_STAGING_PROJECT_REF\" && pnpm exec supabase link --project-ref \"$SUPABASE_STAGING_PROJECT_REF\" || (echo \"Missing SUPABASE_STAGING_PROJECT_REF\" && exit 1)'",
    "db:link:prod": "dotenv -e apps/web/.env.local -- sh -c 'test -n \"$SUPABASE_PROD_PROJECT_REF\" && pnpm exec supabase link --project-ref \"$SUPABASE_PROD_PROJECT_REF\" || (echo \"Missing SUPABASE_PROD_PROJECT_REF\" && exit 1)'",
    "sanity:dev": "dotenv -e apps/web/.env.local -- sanity dev --port 3333",
    "sanity:build": "dotenv -e apps/web/.env.local -- sanity build",
    "sanity:deploy": "dotenv -e apps/web/.env.local -- sanity deploy",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,md,css,json}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9.8.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.9",
    "prettier": "^3.3.3",
    "supabase": "^2.0.0",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@sanity/vision": "^4.6.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sanity": "^4.6.1",
    "sanity-plugin-media": "^4.1.1",
    "sanity-plugin-mux-input": "^2.9.0",
    "styled-components": "^6.1.19"
  }
}
